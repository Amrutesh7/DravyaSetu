{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/Amrutesh7/DravyaSetu/blob/main/shared/contracts/plant.schema.json","title":"DravyaSetu Plant","description":"Canonical plant identity record shared across DravyaSetu services. Naming is preserved from the selected plant directory.","type":"object","additionalProperties":false,"required":["plant_id","plant_identifier","common_name","ayurvedic_regional_names","scientific_name"],"properties":{"plant_id":{"type":"string","pattern":"^PLANT_[0-9]{3}$"},"plant_identifier":{"type":"string","minLength":1},"common_name":{"type":"string","minLength":1},"ayurvedic_regional_names":{"type":"array","items":{"type":"string","minLength":1}},"scientific_name":{"type":"string","minLength":1}}}
