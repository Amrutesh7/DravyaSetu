# Database
DB_PASSWORD=your-secure-postgres-password
DB_URL=jdbc:postgresql://localhost:5432/dravya_setu
DB_USERNAME=dravya_app

# JWT (min 32 chars for HS256)
JWT_SECRET=your-very-long-secret-key-at-least-32-characters-long

# AI Service (Person 1)
AI_BASE_URL=http://localhost:8001
AI_IDENTIFY_PATH=/identify
AI_CONNECT_TIMEOUT_MS=5000
AI_READ_TIMEOUT_MS=30000

# Knowledge Service (Person 3)
KNOWLEDGE_BASE_URL=http://localhost:8002
KNOWLEDGE_ASK_PATH=/ask
KNOWLEDGE_CONNECT_TIMEOUT_MS=5000
KNOWLEDGE_READ_TIMEOUT_MS=30000

# Cloudflare R2 object storage (required for image uploads)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_BUCKET=dravya-setu
R2_PUBLIC_URL=https://your-public-r2-domain
R2_REGION=auto

# Server
SERVER_PORT=8080
