# Database
DB_PASSWORD=your-secure-postgres-password
DB_URL=jdbc:postgresql://localhost:5432/dravya_setu
DB_USERNAME=dravya_app

# JWT (min 32 chars for HS256)
JWT_SECRET=your-very-long-secret-key-at-least-32-characters-long
JWT_EXPIRATION_MS=3600000

# AI Service (Person 1)
# Deployed service: https://a760-st--dravyasetu-ai-fastapi-app.us-east.modal.run (POST /ai/analyze,
# multipart `images`). Use http://localhost:8001 only for a local AI service.
AI_BASE_URL=https://a760-st--dravyasetu-ai-fastapi-app.us-east.modal.run
AI_IDENTIFY_PATH=/ai/analyze
AI_CONNECT_TIMEOUT_MS=10000
# Allow time for Modal container/model cold starts.
AI_READ_TIMEOUT_MS=90000
# The deployed service accepts multipart binary uploads only.
# url = send signed B2 URLs (requires an AI service that accepts URLs).
AI_IMAGE_TRANSPORT=multipart
IDENTIFICATION_MAX_IMAGES=5

# Backblaze B2 (private bucket, S3-compatible API)
# Create the bucket and a bucket-scoped application key in the B2 dashboard.
B2_STORAGE_ENABLED=false
B2_BUCKET=
B2_ENDPOINT=
B2_REGION=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_PATH_STYLE=true
# Display URLs for the frontend; shorter URLs are handed to the AI service.
B2_PRESIGN_TTL=60m
B2_AI_PRESIGN_TTL=15m
B2_MAX_HEATMAP_BYTES=5242880
B2_HEATMAP_TIMEOUT=10s
# Optional comma-separated allowlist for AI heatmap hosts.
B2_HEATMAP_ALLOWED_HOSTS=

# Knowledge Service (Person 3, deployed on Render)
KNOWLEDGE_BASE_URL=https://dravyasetu-knowledge-service.onrender.com
KNOWLEDGE_ASK_PATH=/knowledge/chat
KNOWLEDGE_CONNECT_TIMEOUT_MS=10000
# Render sleeps when idle; give cold starts up to 90s.
KNOWLEDGE_READ_TIMEOUT_MS=90000

# Chat conversation memory (rebuilt by the backend)
CHAT_HISTORY_ENABLED=true
CHAT_HISTORY_MESSAGE_LIMIT=6
CHAT_HISTORY_CHAR_LIMIT=2000

# Transactional email (SMTP). Required for registration and password reset.
# Local development: run `docker compose up mailpit` and use the values below;
# read the delivered messages at http://localhost:8025.
# Production: set your provider's host/port/credentials and a verified MAIL_FROM.
MAIL_ENABLED=true
MAIL_PROVIDER=smtp
BREVO_API_KEY=
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@dravyasetu.local
MAIL_FROM_NAME=DravyaSetu
MAIL_STARTTLS=false
MAIL_SSL=false
MAIL_CONNECT_TIMEOUT_MS=10000
MAIL_WRITE_TIMEOUT_MS=10000

# One-time codes (email verification and password reset)
# OTP_HASH_SECRET keys the stored digests; defaults to JWT_SECRET when unset.
# Set a separate 32+ character value in production.
OTP_HASH_SECRET=
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5
PASSWORD_RESET_TICKET_TTL_MINUTES=10

# CORS and security
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
RATE_LIMIT_ENABLED=true
TRUSTED_PROXY_CIDRS=

# Server / profile. real-ai calls the deployed AI service; add
# real-knowledge for the deployed Knowledge service. Leave blank for mocks.
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=real-ai,real-knowledge
